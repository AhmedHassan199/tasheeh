# Tasheeh System API base URL — يدير المحتوى الديناميك (معلمين، شهادات،
# قبل/بعد، نصوص الـ hero/about/footer) من لوحة الإدارة Filament.
#
# Examples:
#   تطوير محلى:  VITE_API_BASE=http://127.0.0.1:8090/api
#   إنتاج:        VITE_API_BASE=https://admin.tasheeh.com/api
#
# تركه فارغًا → الموقع يستخدم البيانات الافتراضية المدمجة (وضع offline).
VITE_API_BASE=

# Google Apps Script Web App URL — see apps-script/Code.gs for setup steps.
# When empty the form will run in demo mode (success without sending).
VITE_REGISTRATION_ENDPOINT=
